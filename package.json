{
  "name": "frag.jetzt",
  "version": "3.0.1",
  "license": "MIT",
  "scripts": {
    "e2e:test": "./node_modules/.bin/nightwatch --env 'chrome' --config './nightwatch.conf.js'",
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build --configuration production",
    "test": "ng test --watch=false --browsers=ChromeHeadlessCustom --source-map=false --code-coverage",
    "lint": "ng lint",
    "e2e": "ng e2e",
    "extract": "ngx-translate-extract -m _ --input ./src --output ./src/assets/i18n/de.json ./src/assets/i18n/en.json --clean --sort --format namespaced-json",
    "prepare": "husky install",
    "postinstall": "node ./install/post-install.js",
    "docker": "node --trace-uncaught ./install/manage-dependency.mjs",
    "staging": "node ./install/run-with-staging.mjs",
    "production": "node ./install/run-with-production.mjs"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^19.2.3",
    "@angular/cdk": "^19.2.5",
    "@angular/common": "^19.2.3",
    "@angular/compiler": "^19.2.3",
    "@angular/core": "^19.2.3",
    "@angular/flex-layout": "^15.0.0-beta.42",
    "@angular/forms": "^19.2.3",
    "@angular/material": "^19.2.5",
    "@angular/platform-browser": "^19.2.3",
    "@angular/platform-browser-dynamic": "^19.2.3",
    "@angular/platform-server": "^19.2.3",
    "@angular/router": "^19.2.3",
    "@angular/service-worker": "^19.2.3",
    "@angular/ssr": "^19.2.4",
    "@material/material-color-utilities": "^0.3.0",
    "@ngx-translate/core": "^16.0.4",
    "@ngx-translate/http-loader": "^16.0.1",
    "@nightwatch/schematics": "^1.2.1",
    "@shopware-ag/meteor-icon-kit": "^5.3.0",
    "@stomp/ng2-stompjs": "^8.0.0",
    "@toast-ui/editor": "^3.2.2",
    "@toast-ui/editor-plugin-chart": "^3.0.1",
    "@toast-ui/editor-plugin-code-syntax-highlight": "^3.1.0",
    "@toast-ui/editor-plugin-color-syntax": "^3.1.0",
    "@toast-ui/editor-plugin-table-merged-cell": "^3.1.0",
    "@toast-ui/editor-plugin-uml": "^3.0.1",
    "angular-tag-cloud-module": "^17.0.1",
    "angularx-qrcode": "^19.0.0",
    "express": "^4.18.2",
